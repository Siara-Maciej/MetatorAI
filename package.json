{
  "name": "metator-ai-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "arch": "ast-grep test --skip-snapshot-tests && ast-grep scan --filter '^mt-(arch|code|test)-'",
    "check": "bun run lint && bun run typecheck && bun run arch && bun run canon && bun run test && bun run test:mutation",
    "canon": "bun packages/cli/src/main.ts meta check-all --min-e1 100",
    "metator": "bun packages/cli/src/main.ts",
    "test:unit": "bun test packages",
    "test:e2e": "bun test e2e",
    "assets": "bun scripts/assets/generate.ts",
    "test:mutation": "bun scripts/mutation-smoke.ts",
    "schemas:freeze": "bun scripts/freeze-schemas.ts"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@biomejs/biome": "^2.6.3",
    "@metator/testing": "workspace:*",
    "@types/bun": "^1.4.4",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
