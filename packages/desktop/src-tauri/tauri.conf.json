{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetatorAI",
  "version": "0.0.0",
  "identifier": "ai.metator.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MetatorAI",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
